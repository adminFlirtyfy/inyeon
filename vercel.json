{
  "version": 2,

  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "inyeonai.com" }],
      "destination": "https://www.inyeonai.com/$1",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://launchigniter.com https://www.shipit.buzz https://www.bing.com https://*.bing.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://www.bing.com https://*.bing.com https://*.clarity.ms; frame-src 'self' https://www.bing.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ],

  "trailingSlash": false,

  "routes": [
    { "src": "/index\\.html$", "dest": "/", "status": 301 },
    { "src": "/features\\.html$", "dest": "/features", "status": 301 },
    { "src": "/how-it-works\\.html$", "dest": "/how-it-works", "status": 301 },
    { "src": "/community\\.html$", "dest": "/community", "status": 301 },
    { "src": "/faq\\.html$", "dest": "/faq", "status": 301 },
    { "src": "/support\\.html$", "dest": "/support", "status": 301 },
    { "src": "/account\\.html$", "dest": "/account", "status": 301 },
    { "src": "/privacy\\.html$", "dest": "/privacy", "status": 301 },
    { "src": "/terms\\.html$", "dest": "/terms", "status": 301 },

    { "src": "/", "dest": "/index.html" },
    { "src": "/features", "dest": "/features.html" },
    { "src": "/how-it-works", "dest": "/how-it-works.html" },
    { "src": "/community", "dest": "/community.html" },
    { "src": "/faq", "dest": "/faq.html" },
    { "src": "/support", "dest": "/support.html" },
    { "src": "/account", "dest": "/account.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },

    { "handle": "filesystem" },

    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
